# Copy this file to .env and fill in values before running docker compose

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FAST_MODEL=qwen2.5:3b

# Orchestration → .NET API (internal Docker network)
DOTNET_API_BASE_URL=http://dotnet-api:5000
REDIS_URL=redis://redis:6379/0

# TiDB connection (used by .NET API)
# Default matches docker-compose service names — only change if you modify the compose file
TIDB_HOST=tidb
TIDB_PORT=4000

# Development auth bootstrap for the .NET API
JWT_SIGNING_KEY=dev-signing-key-change-me-please-1234567890
DEV_AUTH_USERNAME=admin@property.local
DEV_AUTH_PASSWORD=Passw0rd!
DEV_AUTH_DISPLAY_NAME=Local Admin
